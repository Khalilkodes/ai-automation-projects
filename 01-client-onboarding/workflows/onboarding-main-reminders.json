    {
      "parameters": {
        "jsCode": "const cfg = $('SetConfig').first().json;\n\n// NocoDB returns created_at as \"YYYY-MM-DD HH:mm:ss\" with no time zone.\n// Treat it as UTC (the workflow time zone is Africa/Banjul, which is UTC+0).\nconst parse = (v) => {\n  if (!v) return null;\n  let s = String(v);\n  if (!/[zZ]|[+-]\\d\\d:?\\d\\d$/.test(s)) s = s.replace(' ', 'T') + 'Z';\n  const d = new Date(s);\n  return isNaN(d) ? null : d;\n};\n\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const f = row.fields ?? {};\n\n  // Fail loudly: a row we can't update later must not be silently skipped.\n  if (row.id === undefined || row.id === null) {\n    throw new Error('Client row has no id: ' + JSON.stringify(f.email));\n  }\n\n  const created = parse(f.created_at);\n  if (!created) continue; // no usable signup date, so nothing to decide\n\n  const days = Math.floor((now - created.getTime()) / 86400000);\n\n  // Pick the most advanced step that is due and not yet done.\n  let action = null;\n  if (!f.escalated_at && days >= Number(cfg.escalation_days)) action = 'escalate';\n  else if (!f.reminder_2_sent_at && days >= Number(cfg.reminder_2_days)) action = 'reminder_2';\n  else if (!f.reminder_1_sent_at && days >= Number(cfg.reminder_1_days)) action = 'reminder_1';\n\n  if (!action) continue; // nothing due for this client today\n\n  out.push({\n    json: {\n      rowId: row.id,\n      email: f.email,\n      full_name: f.full_name,\n      created_at: f.created_at,\n      days,\n      action,\n    },\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        176
      ],
      "id": "66149143-b082-41b3-baaa-27f1b22b7b8f",
      "name": "DecideAction"
    },
