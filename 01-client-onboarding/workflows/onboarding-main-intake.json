        "jsCode": "const client = $('CleanInput').first().json;\nconst standard = ['id_document', 'business_registration', 'bank_statements', 'tax_records'];\nconst extra = ['audited_financials', 'payroll_records'];\nconst docs = client.business_type === 'large' ? [...standard, ...extra] : standard;\n\nreturn docs.map(doc_type => ({\n  json: { client_email: client.email_clean, doc_type, status: 'pending' },\n}));"
