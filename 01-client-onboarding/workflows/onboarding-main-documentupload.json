    {
      "parameters": {
        "jsCode": "const cfg = $('SetConfig').first().json;\nconst form = $('DocumentUploadForm').first();\n\n// The uploaded file arrives as binary data under a key we don't need to know.\nconst keys = Object.keys(form.binary ?? {});\nconst file = keys.length ? form.binary[keys[0]] : null;\n\nconst fileName = file?.fileName ?? '';\nconst ext = fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : '';\nconst allowed = String(cfg.allowed_extensions).split(',').map(s => s.trim().toLowerCase());\n\nreturn [{\n  json: {\n    email_clean: String(form.json.email ?? '').trim().toLowerCase(),\n    doc_type: form.json.doc_type,\n    file_name: fileName,\n    file_ext: ext,\n    file_ok: file !== null && allowed.includes(ext),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "5b573aa4-d63c-4811-8f36-9f4c7981622e",
